<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dev_off">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/wd_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_dev_bulb" />

        <TextView
            android:id="@+id/wd_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Switch"
            android:textColor="#EEEAE2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wd_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tap to switch"
            android:textColor="#9A958C"
            android:textSize="10sp" />

        <!-- Auto-off: Android telt zelf af ("off in 12:53"), zonder de app te wekken -->
        <Chronometer
            android:id="@+id/wd_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#E8A317"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Verversen: alleen de toestand opvragen, niet schakelen -->
    <ImageView
        android:id="@+id/wd_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:contentDescription="Refresh"
        android:padding="7dp"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
