<?xml version="1.0" encoding="utf-8"?>
<!-- Voorbeeldplaatje in de widgetlijst van de launcher -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="110dp" android:height="110dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1F1F1F" />
            <stroke android:width="2dp" android:color="#FF3A3A3A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_prev_moon" android:width="54dp" android:height="54dp"
        android:gravity="center" />
</layer-list>
