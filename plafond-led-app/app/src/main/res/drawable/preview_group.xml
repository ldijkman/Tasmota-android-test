<?xml version="1.0" encoding="utf-8"?>
<!-- Voorbeeldplaatje in de widgetlijst van de launcher -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="110dp" android:height="110dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF262117" />
            <stroke android:width="3dp" android:color="#FFE8A317" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_prev_group" android:width="54dp" android:height="54dp"
        android:gravity="center" />
    <item android:drawable="@drawable/ic_prev_refresh" android:width="22dp" android:height="22dp"
        android:gravity="top|end" android:top="10dp" android:right="10dp" />
</layer-list>
