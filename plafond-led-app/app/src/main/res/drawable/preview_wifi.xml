<?xml version="1.0" encoding="utf-8"?>
<!-- Voorbeeldplaatje wifi-widget (3x1): wifi-teken links, gele "Switch"-knop rechts -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="240dp" android:height="64dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1F1F1F" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_wifi" android:width="34dp" android:height="34dp"
        android:gravity="start|center_vertical" android:left="18dp" />
    <item android:width="54dp" android:height="10dp" android:gravity="start|center_vertical" android:left="64dp" android:bottom="14dp">
        <shape android:shape="rectangle"><solid android:color="#FFEEEAE2" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:width="80dp" android:height="7dp" android:gravity="start|center_vertical" android:left="64dp" android:top="16dp">
        <shape android:shape="rectangle"><solid android:color="#FF9A958C" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:width="64dp" android:height="44dp" android:gravity="end|center_vertical" android:right="10dp">
        <shape android:shape="rectangle"><solid android:color="#FFE8A317" /><corners android:radius="14dp" /></shape>
    </item>
</layer-list>
