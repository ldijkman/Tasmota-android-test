<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nodig om een nieuwe versie van de app zelf te installeren (knop "Check for update") -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nodig om even met de wifi van een nieuw Tasmota-apparaat te verbinden (Add new device) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Nodig om de naam (SSID) van het wifi-netwerk te mogen lezen -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Tailscale-app mogen zien (status tonen, aan/uit zetten) -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:label="Tasmota Scan&#160;&amp;&#160;Control"
        android:icon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Setup-bestand openen of delen naar de app (groepen, namen, scènes, pictogrammen) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Openen vanaf de website: tasmotascan://open (of scenes, tiles) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tasmotascan" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Wandpaneel: de app als startscherm (Home-knop komt terug in de app). Standaard uit;
             de gebruiker zet het aan in het menu en kiest het daarna in Android als Home-app. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Na een update vanuit de app: app weer openen -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Status van de update-installatie (PackageInstaller) -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Geeft de gedownloade update (APK) door aan het Android-installatiescherm -->
        <provider
            android:name=".ApkProvider"
            android:authorities="nl.dijkman.plafondled.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Widget per schakelaar: kiezen bij plaatsen, tik = aan/uit -->
        <receiver
            android:name=".DeviceWidget"
            android:exported="true"
            android:label="@string/dev_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- Widget per groep: tik = hele groep aan/uit -->
        <receiver
            android:name=".GroupWidget"
            android:exported="true"
            android:label="@string/grp_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/group_widget_info" />
        </receiver>

        <!-- Widget per scène: tik = scène uitvoeren -->
        <receiver
            android:name=".SceneWidget"
            android:exported="true"
            android:label="@string/scene_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scene_widget_info" />
        </receiver>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/dev_widget_label"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WifiWidget"
            android:exported="true"
            android:label="@string/wifi_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wifi_widget_info" />
        </receiver>
        <receiver
            android:name=".TailscaleWidget"
            android:exported="true"
            android:label="@string/ts_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tailscale_widget_info" />
        </receiver>
    </application>
</manifest>
